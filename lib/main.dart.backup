void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => CourseState(),
      child: const CourseExplorerApp(),
    ),
  );
}

class CourseExplorerApp extends StatelessWidget {
  const CourseExplorerApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Course Explorer',
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.blue),
        scaffoldBackgroundColor: const Color(0xFFF5F8FC),
      ),
      home: const CourseExplorerPage(),
    );
  }
}

class Course {
  final String code;
  final String name;
  final String description;
  final IconData icon;

  const Course({
    required this.code,
    required this.name,
    required this.description,
    required this.icon,
  });
}

const List<Course> courses = [
  Course(
    code: 'PM001',
    name: 'Pemrograman Mobile',
    description: 'Belajar membuat aplikasi mobile dengan Flutter dan Dart.',
    icon: Icons.phone_android,
  ),
  Course(
    code: 'PW002',
    name: 'Pemrograman Web',
    description: 'Mempelajari pengembangan aplikasi berbasis web.',
    icon: Icons.language,
  ),
  Course(
    code: 'BD003',
    name: 'Basis Data',
    description: 'Mempelajari pengelolaan dan perancangan basis data.',
    icon: Icons.storage,
  ),
  Course(
    code: 'AI004',
    name: 'Kecerdasan Buatan',
    description: 'Mengenal konsep AI dan penerapannya dalam kehidupan.',
    icon: Icons.smart_toy,
  ),
  Course(
    code: 'RPL005',
    name: 'Rekayasa Perangkat Lunak',
    description: 'Mempelajari proses perancangan perangkat lunak.',
    icon: Icons.code,
  ),
];

class CourseExplorerPage extends StatefulWidget {
  const CourseExplorerPage({super.key});

  @override
  State<CourseExplorerPage> createState() => _CourseExplorerPageState();
}

class _CourseExplorerPageState extends State<CourseExplorerPage> {
  int selectedIndex = 0;

  void showCourseDetail(Course course) {
    showDialog<void>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        icon: Icon(course.icon, size: 42, color: Colors.blue),
        title: Text(course.name),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Kode: ${course.code}'),
            const SizedBox(height: 12),
            Text(course.description),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('Tutup'),
          ),
          FilledButton(
            onPressed: () {
              Navigator.pop(dialogContext);
              showFeedbackDialog(course);
            },
            child: const Text('Beri Masukan'),
          ),
        ],
      ),
    );
  }

  void showFeedbackDialog(Course course) {
    final controller = TextEditingController();

    showDialog<void>(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text('Masukan: ${course.name}'),
        content: TextField(
          controller: controller,
          maxLines: 3,
          decoration: const InputDecoration(
            labelText: 'Tulis masukan',
            hintText: 'Masukkan pendapat kamu...',
            border: OutlineInputBorder(),
          ),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('Batal'),
          ),
          FilledButton(
            onPressed: () {
              Navigator.pop(dialogContext);
              ScaffoldMessenger.of(context).showSnackBar(
                const SnackBar(
                  content: Text('Terima kasih atas masukannya!'),
                ),
              );
            },
            child: const Text('Kirim'),
          ),
        ],
      ),
    ).then((_) => controller.dispose());
  }

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final isWide = constraints.maxWidth >= 840;

        final pages = [
          HomePage(
            onCourseTap: showCourseDetail,
            onNavigate: (index) => setState(() => selectedIndex = index),
          ),
          CoursesPage(onCourseTap: showCourseDetail),
          const ProfilePage(),
        ];

        return Scaffold(
          body: SafeArea(
            child: Row(
              children: [
                if (isWide)
                  NavigationRail(
                    selectedIndex: selectedIndex,
                    onDestinationSelected: (index) {
                      setState(() => selectedIndex = index);
                    },
                    labelType: NavigationRailLabelType.all,
                    leading: const Padding(
                      padding: EdgeInsets.symmetric(vertical: 24),
                      child: Icon(
                        Icons.school,
                        size: 34,
                        color: Colors.blue,
                      ),
                    ),
                    destinations: const [
                      NavigationRailDestination(
                        icon: Icon(Icons.home_outlined),
                        selectedIcon: Icon(Icons.home),
                        label: Text('Home'),
                      ),
                      NavigationRailDestination(
                        icon: Icon(Icons.menu_book_outlined),
                        selectedIcon: Icon(Icons.menu_book),
                        label: Text('Courses'),
                      ),
                      NavigationRailDestination(
                        icon: Icon(Icons.person_outline),
                        selectedIcon: Icon(Icons.person),
                        label: Text('Profile'),
                      ),
                    ],
                  ),
                Expanded(
                  child: IndexedStack(
                    index: selectedIndex,
                    children: pages,
                  ),
                ),
              ],
            ),
          ),
          bottomNavigationBar: isWide
              ? null
              : NavigationBar(
                  selectedIndex: selectedIndex,
                  onDestinationSelected: (index) {
                    setState(() => selectedIndex = index);
                  },
                  destinations: const [
                    NavigationDestination(
                      icon: Icon(Icons.home_outlined),
                      selectedIcon: Icon(Icons.home),
                      label: 'Home',
                    ),
                    NavigationDestination(
                      icon: Icon(Icons.menu_book_outlined),
                      selectedIcon: Icon(Icons.menu_book),
                      label: 'Courses',
                    ),
                    NavigationDestination(
                      icon: Icon(Icons.person_outline),
                      selectedIcon: Icon(Icons.person),
                      label: 'Profile',
                    ),
                  ],
                ),
        );
      },
    );
  }
}

class BlueHeader extends StatelessWidget {
  final String title;
  final String subtitle;

  const BlueHeader({
    super.key,
    required this.title,
    required this.subtitle,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(24),
      decoration: const BoxDecoration(
        gradient: LinearGradient(
          colors: [Color(0xFF1565C0), Color(0xFF42A5F5)],
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
        ),
        borderRadius: BorderRadius.all(Radius.circular(24)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            title,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 25,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 8),
          Text(
            subtitle,
            style: const TextStyle(color: Colors.white, fontSize: 14),
          ),
        ],
      ),
    );
  }
}

class HomePage extends StatefulWidget {
  final ValueChanged<Course> onCourseTap;
  final ValueChanged<int> onNavigate;

  const HomePage({
    super.key,
    required this.onCourseTap,
    required this.onNavigate,
  });

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  final ValueNotifier<int> counter = ValueNotifier<int>(0);
  int setStateCounter = 0;

  @override
  void dispose() {
    counter.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        BlueHeader(
          title: 'Course Explorer',
          subtitle: 'Halo, $studentName! Yuk, lanjut belajar.',
        ),
        const SizedBox(height: 24),
        Row(
          children: [
            Expanded(
              child: _SummaryCard(
                icon: Icons.menu_book,
                title: 'Total Mata Kuliah',
                value: '${courses.length}',
              ),
            ),
            const SizedBox(width: 12),
            const Expanded(child: FavoriteCountCard()),
          ],
        ),
        const SizedBox(height: 28),
        const Text(
          'Eksperimen ValueNotifier',
          style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 14),
        Card(
          elevation: 0,
          color: Colors.white,
          child: Padding(
            padding: const EdgeInsets.all(18),
            child: Column(
              children: [
                const Text('Nilai ValueNotifier'),
                const SizedBox(height: 8),
                ValueListenableBuilder<int>(
                  valueListenable: counter,
                  builder: (context, value, child) => Text(
                    '$value',
                    style: const TextStyle(
                      fontSize: 36,
                      fontWeight: FontWeight.bold,
                      color: Colors.blue,
                    ),
                  ),
                ),
                FilledButton.icon(
                  onPressed: () => counter.value++,
                  icon: const Icon(Icons.add),
                  label: const Text('Tambah ValueNotifier'),
                ),
                const Divider(height: 30),
                const Text('Nilai setState() sebagai pembanding'),
                const SizedBox(height: 8),
                Text(
                  '$setStateCounter',
                  style: const TextStyle(
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                    color: Colors.deepPurple,
                  ),
                ),
                OutlinedButton.icon(
                  onPressed: () => setState(() => setStateCounter++),
                  icon: const Icon(Icons.refresh),
                  label: const Text('Tambah dengan setState()'),
                ),
              ],
            ),
          ),
        ),
        const SizedBox(height: 28),
        Row(
          mainAxisAlignment: MainAxisAlignment.spaceBetween,
          children: [
            const Text(
              'Mata Kuliah',
              style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
            TextButton(
              onPressed: () => widget.onNavigate(1),
              child: const Text('Lihat semua'),
            ),
          ],
        ),
        ...courses.take(3).map(
          (course) => CourseCard(
            course: course,
            onTap: () => widget.onCourseTap(course),
          ),
        ),
      ],
    );
  }
}

// watch(): widget ini rebuild ketika jumlah favorit berubah.
class FavoriteCountCard extends StatelessWidget {
  const FavoriteCountCard({super.key});

  @override
  Widget build(BuildContext context) {
    final courseState = context.watch<CourseState>();

    return _SummaryCard(
      icon: Icons.favorite,
      title: 'Mata Kuliah Favorit',
      value: '${courseState.favorites.length}',
    );
  }
}

class CoursesPage extends StatelessWidget {
  final ValueChanged<Course> onCourseTap;

  const CoursesPage({super.key, required this.onCourseTap});

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        const BlueHeader(
          title: 'Daftar Mata Kuliah',
          subtitle: 'Pilih mata kuliah dan simpan favoritmu.',
        ),
        const SizedBox(height: 24),
        ...courses.map(
          (course) => CourseCard(
            course: course,
            onTap: () => onCourseTap(course),
          ),
        ),
      ],
    );
  }
}

class CourseCard extends StatelessWidget {
  final Course course;
  final VoidCallback onTap;

  const CourseCard({
    super.key,
    required this.course,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      elevation: 0,
      color: Colors.white,
      child: ListTile(
        contentPadding: const EdgeInsets.all(12),
        leading: CircleAvatar(
          radius: 26,
          backgroundColor: Colors.blue.shade50,
          child: Icon(course.icon, color: Colors.blue),
        ),
        title: Text(
          course.name,
          style: const TextStyle(fontWeight: FontWeight.bold),
        ),
        subtitle: Text(course.code),
        onTap: onTap,
        trailing: Consumer<CourseState>(
          builder: (context, courseState, child) {
            final isFavorite = courseState.isFavorite(course.code);

            return IconButton(
              tooltip: isFavorite ? 'Hapus dari favorit' : 'Tambah ke favorit',
              onPressed: () {
                // read(): panggil aksi tanpa listen.
                context.read<CourseState>().toggleFavorite(course.code);
              },
              icon: Icon(
                isFavorite ? Icons.favorite : Icons.favorite_border,
                color: isFavorite ? Colors.red : Colors.grey,
              ),
            );
          },
        ),
      ),
    );
  }
}

